# ---------------------------------------------------------------------------
# Supabase — 여기 두 줄만 채우면 프론트 연동됩니다.
# Supabase 대시보드: Project Settings → API
# ---------------------------------------------------------------------------
# 로컬: 이 파일을 복사해 `.env.local` 로 저장한 뒤 아래 값만 수정하세요.
#       (`.env.local` 은 .gitignore 에 있어 커밋되지 않습니다.)
#
# Vercel: Project → Settings → Environment Variables → Production(및 Preview) 체크 후 Redeploy
#   권장 이름: VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY
#   (빌드 설정이 SUPABASE_URL / SUPABASE_ANON_KEY 만 쓰는 경우에도 동일 값으로 인식합니다.)
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# ---------------------------------------------------------------------------
# Vercel Serverless API / 로컬 npm run dev 의 댓글·글 삭제 API
# 서비스 롤 키는 절대 VITE_ 로 노출하지 마세요.
#
# 로컬에서 Supabase 댓글 삭제가 되려면 아래 두 값이 .env.local 에 있어야 합니다.
# (Vite 개발 서버가 /api/delete-comment 를 대신 처리합니다.)
# ---------------------------------------------------------------------------

SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=
GEMINI_API_KEY=
